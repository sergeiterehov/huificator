{
    "name": "Журбанизатор",
    "description": "Наполни сайт глубоким смыслом!",
    "version": "2.0",
    "manifest_version": 3,
    "minimum_chrome_version": "88",
    "permissions": [
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "all_frames": true,
            "js": [
                "index.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "extension.png"
    },
    "icons": {
        "128": "extension.png"
    }
}
